# .editorconfig – gleiche Grundeinstellungen in jedem Editor (VS Code: Erweiterung „EditorConfig")
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# In Markdown bedeuten zwei Leerzeichen am Zeilenende einen Zeilenumbruch.
[*.md]
trim_trailing_whitespace = false
